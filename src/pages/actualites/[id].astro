---
// Article d'actualite (francais). getStaticPaths ne retient que les actualites francaises ;
// le corps de page vit dans le composant partage, auto-localise.
import { getCollection } from 'astro:content';
import Actualite from '../../components/pages/Actualite.astro';

export async function getStaticPaths() {
  const actualites = await getCollection('actualites', (e) => e.data.publie === true && e.data.lang !== 'en');
  return actualites.map((a) => ({ params: { id: a.id }, props: { a } }));
}

const { a } = Astro.props;
---
<Actualite a={a} />
