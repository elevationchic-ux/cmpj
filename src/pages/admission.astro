---
// Admission et inscription : demarche (contenu editable) + formulaire de pre-inscription.
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import EnTetePage from '../components/EnTetePage.astro';
import FormInscription from '../components/FormInscription.astro';
import FormEnhancement from '../components/FormEnhancement.astro';
import { getFilieresPubliees, getOrganisation, lienWhatsApp } from '../lib/contenu';

const page = await getEntry('pages', 'admission');
const { Content } = page ? await render(page) : { Content: null };
const filieres = await getFilieresPubliees();
const org = await getOrganisation();
const whatsapp = lienWhatsApp(org.contacts?.whatsapp, 'Bonjour, je souhaite des renseignements sur l\'inscription au CMPJ Régional du Littoral.');

const titre = 'Admission et inscription | CMPJ Régional du Littoral';
const description = page?.data.description ?? '';
const fil = [{ titre: 'Accueil', url: '/' }, { titre: 'Admission' }];
---

<BaseLayout title={titre} description={description}>
  <EnTetePage titre="Admission et inscription" chapeau={description} fil={fil} />

  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-10 lg:grid-cols-[1.1fr_1fr]">
    <article class="prose max-w-none">
      {Content ? <Content /> : (
        <p>L'admission se fait par le dépôt d'un dossier complet au secrétariat du Centre. Les conditions, pièces et frais propres à chaque filière sont précisés lors du retrait du dossier.</p>
      )}
    </article>

    <section aria-labelledby="pre-inscription" class="section-titre rounded border border-filet bg-white p-6">
      <h2 id="pre-inscription">Pré-inscription en ligne</h2>
      <FormInscription filieres={filieres} />
      {whatsapp && (
        <p class="mt-4 text-sm">
          Une question avant de déposer votre dossier ?
          <a class="font-semibold no-underline hover:underline" href={whatsapp} target="_blank" rel="noopener noreferrer">Écrire sur WhatsApp</a>.
        </p>
      )}
    </section>
  </div>

  <FormEnhancement />
</BaseLayout>
