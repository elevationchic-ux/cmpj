---
// Barre d'action fixe en bas d'ecran, mobile uniquement : les deux gestes utiles.
import { getLang, localizeUrl, t } from '../lib/i18n';
const lang = getLang(Astro.url.pathname);
---
<div class="fixed inset-x-0 bottom-0 z-40 border-t border-filet bg-white/95 p-2 backdrop-blur lg:hidden">
  <div class="flex gap-2">
    <a href={localizeUrl('/formations/', lang)} class="flex-1 rounded border border-vert bg-white py-2.5 text-center text-sm font-semibold text-vert no-underline">
      {t(lang, 'mob.choose')}
    </a>
    <a href={localizeUrl('/admission/', lang)} class="flex-1 rounded bg-brique py-2.5 text-center text-sm font-semibold text-white no-underline">
      {t(lang, 'mob.pre')}
    </a>
  </div>
</div>
