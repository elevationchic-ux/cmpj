---
// Bouton WhatsApp flottant. Affiche uniquement si le numero est fourni par le Centre.
import { lienWhatsApp } from '../lib/contenu';
import { getLang, t } from '../lib/i18n';

const { org } = Astro.props;
const lang = getLang(Astro.url.pathname);
const whatsapp = org.contacts?.whatsapp;
const message = t(lang, 'wa.msg.general');
const href = lienWhatsApp(whatsapp, message);
---

{
  href && (
    <a
      href={href}
      class="fixed bottom-20 right-4 z-40 inline-flex items-center gap-2 rounded bg-[#128C7E] px-4 py-3 text-sm font-semibold text-white shadow-sm no-underline hover:bg-[#0f7a6e] focus-visible:outline-2 lg:bottom-4"
      aria-label={t(lang, 'wa.aria')}
      rel="noopener noreferrer"
      target="_blank">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M17.5 14.4c-.3-.15-1.7-.85-2-.95-.25-.1-.45-.15-.6.15-.2.3-.75.95-.9 1.15-.15.2-.3.2-.6.05-.3-.15-1.25-.45-2.4-1.45-.9-.8-1.5-1.75-1.65-2.05-.15-.3 0-.45.15-.6.15-.15.3-.35.45-.5.15-.15.2-.25.3-.45.1-.2.05-.35-.05-.5-.1-.15-.6-1.4-.8-1.9-.2-.45-.4-.4-.6-.4h-.5c-.15 0-.4.05-.6.3-.2.3-.8.75-.8 1.85s.8 2.15.9 2.3c.1.15 1.5 2.35 3.7 3.3.5.2.9.35 1.2.45.5.15.95.15 1.3.1.4-.05 1.2-.5 1.4-1 .15-.5.15-.9.1-1-.05-.1-.2-.15-.4-.25zM12 2a10 10 0 0 0-8.6 15l-1.4 5 5.1-1.3A10 10 0 1 0 12 2z" />
      </svg>
      <span>WhatsApp</span>
    </a>
  )
}
