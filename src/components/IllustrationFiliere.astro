---
// Illustration de filiere : SVG inline, style plat et geometrique, palette du Centre.
// Decoratif (aria-hidden), aucun fichier image, aucun poids reseau.
// Cadre commun (fond, halos) puis un motif propre a chaque metier.
interface Props {
  nom: string;
  classe?: string;
}
const { nom, classe = 'h-full w-full' } = Astro.props;
const uid = String(nom).replace(/[^a-z0-9]/gi, '');
---
<svg viewBox="0 0 320 200" class={classe} preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id={`fond-${uid}`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#eef5ef" />
      <stop offset="1" stop-color="#ffffff" />
    </linearGradient>
    <linearGradient id={`acier-${uid}`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#d6ddd9" />
      <stop offset="1" stop-color="#9aa6a0" />
    </linearGradient>
  </defs>

  <rect width="320" height="200" fill={`url(#fond-${uid})`} />
  <circle cx="286" cy="18" r="96" fill="#0f5b3a" opacity="0.07" />
  <circle cx="24" cy="192" r="70" fill="#e4b300" opacity="0.14" />
  <circle cx="44" cy="22" r="26" fill="#b3202a" opacity="0.08" />
  <rect x="0" y="176" width="320" height="4" fill="#0f5b3a" opacity="0.06" />

  {nom === 'metal' && (
    <g>
      <path d="M96 168 V120 a64 60 0 0 1 128 0 V168" fill="none" stroke="#0f5b3a" stroke-width="22" stroke-linecap="round" />
      <path d="M96 168 V120 a64 60 0 0 1 128 0 V168" fill="none" stroke="#4b8f6b" stroke-width="9" stroke-linecap="round" />
      <rect x="84" y="164" width="32" height="10" rx="4" fill="#0a3f28" />
      <rect x="204" y="164" width="32" height="10" rx="4" fill="#0a3f28" />
      <circle cx="128" cy="120" r="4" fill={`url(#acier-${uid})`} />
      <circle cx="160" cy="104" r="4" fill={`url(#acier-${uid})`} />
      <circle cx="192" cy="120" r="4" fill={`url(#acier-${uid})`} />
      <g stroke="#e4b300" stroke-width="4" stroke-linecap="round">
        <path d="M160 52 v-14" /><path d="M178 58 l10-10" /><path d="M142 58 l-10-10" />
      </g>
      <circle cx="160" cy="66" r="7" fill="#b3202a" />
    </g>
  )}

  {nom === 'electricite' && (
    <g>
      <rect x="112" y="58" width="96" height="96" rx="16" fill="#0f5b3a" opacity="0.1" />
      <g stroke="#4b8f6b" stroke-width="3" opacity="0.7" fill="none">
        <path d="M128 58 v-14 h20" /><path d="M192 58 v-14 h-14" /><path d="M128 154 v12 h24" /><path d="M192 154 v12 h-16" />
      </g>
      <circle cx="150" cy="42" r="4" fill="#b3202a" /><circle cx="178" cy="42" r="4" fill="#e4b300" />
      <circle cx="154" cy="168" r="4" fill="#e4b300" /><circle cx="174" cy="168" r="4" fill="#b3202a" />
      <path d="M172 66 l-40 52 h24 l-10 44 44-58 h-26 l8-38z" fill="#e4b300" stroke="#0a3f28" stroke-width="3" stroke-linejoin="round" />
    </g>
  )}

  {nom === 'textile' && (
    <g>
      <rect x="92" y="64" width="52" height="92" rx="8" fill="#0f5b3a" />
      <g fill="#4b8f6b">
        <rect x="100" y="64" width="8" height="92" opacity="0.8" /><rect x="116" y="64" width="8" height="92" opacity="0.5" /><rect x="132" y="64" width="8" height="92" opacity="0.8" />
      </g>
      <ellipse cx="118" cy="64" rx="26" ry="8" fill="#e7efe9" />
      <path d="M150 148 q46 -6 70 -66" fill="none" stroke="#b3202a" stroke-width="4" stroke-dasharray="2 12" stroke-linecap="round" />
      <path d="M214 74 l30 -22" stroke={`url(#acier-${uid})`} stroke-width="5" stroke-linecap="round" />
      <circle cx="248" cy="50" r="7" fill="none" stroke="#0a3f28" stroke-width="4" />
      <path d="M196 150 q26 18 52 -2" fill="none" stroke="#e4b300" stroke-width="4" stroke-linecap="round" />
    </g>
  )}

  {nom === 'automobile' && (
    <g>
      <path d="M118 112 l18 -30 h70 l22 30z" fill="#4b8f6b" />
      <rect x="74" y="110" width="176" height="34" rx="14" fill="#0f5b3a" />
      <path d="M126 110 l14 -22 h34 l18 22z" fill="#e7efe9" opacity="0.85" />
      <path d="M74 128 h176" stroke="#0a3f28" stroke-width="3" opacity="0.5" />
      <circle cx="250" cy="120" r="8" fill="#e4b300" />
      <g>
        <circle cx="116" cy="150" r="20" fill="#0a3f28" /><circle cx="116" cy="150" r="8" fill={`url(#acier-${uid})`} />
        <circle cx="204" cy="150" r="20" fill="#0a3f28" /><circle cx="204" cy="150" r="8" fill={`url(#acier-${uid})`} />
      </g>
      <rect x="150" y="46" width="20" height="20" rx="4" fill="none" stroke="#b3202a" stroke-width="4" />
    </g>
  )}

  {nom === 'menuiserie' && (
    <g>
      <path d="M122 172 v-64 a38 34 0 0 1 76 0 v64z" fill="#c98a4b" />
      <path d="M134 168 v-56 a26 22 0 0 1 52 0 v56z" fill="#a9673a" />
      <g stroke="#8a4f28" stroke-width="3" opacity="0.6" fill="none">
        <path d="M146 120 v44" /><path d="M160 112 v52" /><path d="M174 120 v44" />
      </g>
      <circle cx="184" cy="140" r="6" fill="#e4b300" />
      <rect x="208" y="150" width="70" height="16" rx="8" fill="#0f5b3a" />
      <rect x="214" y="140" width="16" height="12" rx="3" fill="#4b8f6b" />
      <path d="M96 60 h96" stroke="#b3202a" stroke-width="5" stroke-linecap="round" stroke-dasharray="2 14" />
    </g>
  )}

  {nom === 'graphique' && (
    <g>
      <rect x="92" y="58" width="136" height="96" rx="12" fill="#e7efe9" stroke="#0f5b3a" stroke-width="4" />
      <path d="M108 132 C138 132 132 84 168 84 C204 84 196 128 216 108" fill="none" stroke="#b3202a" stroke-width="4" />
      <rect x="100" y="124" width="14" height="14" rx="3" fill="#e4b300" />
      <rect x="208" y="100" width="14" height="14" rx="3" fill="#e4b300" />
      <circle cx="168" cy="84" r="6" fill="#0f5b3a" />
      <path d="M214 40 l44 24 -18 8 -6 18z" fill="#0a3f28" />
      <g><circle cx="118" cy="170" r="8" fill="#0f5b3a" /><circle cx="146" cy="170" r="8" fill="#b3202a" /><circle cx="174" cy="170" r="8" fill="#e4b300" /></g>
    </g>
  )}

  {nom === 'maconnerie' && (
    <g>
      <g fill="#b3202a">
        <rect x="90" y="118" width="40" height="18" rx="3" /><rect x="134" y="118" width="40" height="18" rx="3" /><rect x="178" y="118" width="40" height="18" rx="3" />
        <rect x="90" y="140" width="18" height="18" rx="3" /><rect x="112" y="140" width="40" height="18" rx="3" /><rect x="156" y="140" width="40" height="18" rx="3" /><rect x="200" y="140" width="18" height="18" rx="3" />
      </g>
      <g fill="#d9646b">
        <rect x="90" y="118" width="40" height="5" rx="2" /><rect x="134" y="118" width="40" height="5" rx="2" /><rect x="178" y="118" width="40" height="5" rx="2" />
        <rect x="112" y="140" width="40" height="5" rx="2" /><rect x="156" y="140" width="40" height="5" rx="2" />
      </g>
      <rect x="134" y="96" width="40" height="18" rx="3" fill="#e4b300" />
      <path d="M178 108 h40 a6 6 0 0 1 6 6 v0 a4 4 0 0 1 -4 4 h-42z" fill="#dfe6e2" />
      <path d="M224 96 l34 -26" stroke="#a9673a" stroke-width="10" stroke-linecap="round" />
      <path d="M240 62 a10 10 0 0 1 18 8 l-16 8z" fill="#c98a4b" />
      <g stroke="#4b8f6b" stroke-width="4" stroke-linecap="round"><path d="M120 172 v-6" /><path d="M160 172 v-6" /><path d="M200 172 v-6" /></g>
    </g>
  )}

  {/* Repli discret si le metier n'a pas de motif dedie */}
  {![ 'metal', 'electricite', 'textile', 'automobile', 'menuiserie', 'graphique', 'maconnerie'].includes(nom) && (
    <circle cx="160" cy="106" r="40" fill="none" stroke="#0f5b3a" stroke-width="6" opacity="0.3" />
  )}
</svg>
