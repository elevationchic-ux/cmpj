---
// Formulaire de pre-inscription. Les filieres proposees proviennent du contenu du Centre.
import type { CollectionEntry } from 'astro:content';
import { getLang, t } from '../lib/i18n';
import { getFilieresPubliees } from '../lib/contenu';

interface Props {
  filieres?: CollectionEntry<'filieres'>[];
}
const props = Astro.props;
const lang = getLang(Astro.url.pathname);
// Si la page n'a pas passe de filieres, on les sert directement dans la langue courante.
const filieres = props.filieres && props.filieres.length > 0 ? props.filieres : await getFilieresPubliees(lang);
const tstamp = Math.floor(Date.now() / 1000);
const champ = 'mt-1 w-full rounded border border-filet bg-white px-3 py-2 outline-none focus:border-vert';
const erreur = 'mt-1 hidden text-sm text-brique';
---
<form data-form data-action="/api/inscription" method="post" class="space-y-4">
  <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" class="absolute left-[-9999px] h-0 w-0 opacity-0" />
  <input type="hidden" name="t" value={tstamp} />
  <input type="hidden" name="lang" value={lang} />

  <div class="grid gap-4 sm:grid-cols-2">
    <div>
      <label for="i-nom" class="block font-semibold">{t(lang, 'form.name')} <span class="text-brique" aria-hidden="true">*</span></label>
      <input id="i-nom" name="nom" type="text" required autocomplete="family-name" class={champ} />
      <p class={erreur} data-err="nom"></p>
    </div>
    <div>
      <label for="i-prenom" class="block font-semibold">{t(lang, 'form.first_name')} <span class="text-brique" aria-hidden="true">*</span></label>
      <input id="i-prenom" name="prenom" type="text" required autocomplete="given-name" class={champ} />
      <p class={erreur} data-err="prenom"></p>
    </div>
    <div>
      <label for="i-email" class="block font-semibold">{t(lang, 'form.email')} <span class="text-brique" aria-hidden="true">*</span></label>
      <input id="i-email" name="email" type="email" required autocomplete="email" class={champ} />
      <p class={erreur} data-err="email"></p>
    </div>
    <div>
      <label for="i-tel" class="block font-semibold">{t(lang, 'form.phone')} <span class="text-brique" aria-hidden="true">*</span></label>
      <input id="i-tel" name="telephone" type="tel" required autocomplete="tel" class={champ} />
      <p class={erreur} data-err="telephone"></p>
    </div>
  </div>

  <div>
    <label for="i-filiere" class="block font-semibold">{t(lang, 'form.trade')} <span class="text-brique" aria-hidden="true">*</span></label>
    <select id="i-filiere" name="filiere" required class={champ}>
      <option value="">{t(lang, 'form.trade_placeholder')}</option>
      {filieres.map((f) => <option value={f.data.titre}>{f.data.titre}</option>)}
    </select>
    <p class={erreur} data-err="filiere"></p>
  </div>

  <div>
    <label for="i-annee" class="block font-semibold">{t(lang, 'form.birth_year')}</label>
    <input id="i-annee" name="annee" type="number" min="1960" max="2020" inputmode="numeric" class={champ} />
  </div>

  <div>
    <label for="i-commentaire" class="block font-semibold">{t(lang, 'form.note_label')}</label>
    <textarea id="i-commentaire" name="commentaire" rows="3" class={champ}></textarea>
  </div>

  <p class="text-sm text-gris">{t(lang, 'form.pre_note')}</p>

  <div>
    <button type="submit" class="rounded bg-vert px-5 py-2.5 font-semibold text-white hover:bg-vert-nuit">{t(lang, 'form.submit_pre')}</button>
  </div>

  <p role="status" aria-live="polite" tabindex="-1" class="hidden rounded border border-vert bg-vert-clair px-4 py-3 text-vert-nuit" data-ok>
    {t(lang, 'form.ok_pre')}
  </p>
  <p role="alert" class="hidden rounded border border-brique px-4 py-3 text-brique" data-fail>
    {t(lang, 'form.fail')}
  </p>
</form>
