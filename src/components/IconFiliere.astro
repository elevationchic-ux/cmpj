---
// Pictogramme de filiere : SVG inline, trait de 1.7, monochrome, couleur heritee du texte.
// Aucun fichier image, aucun poids reseau. Arriere-plan decoratif, masque pour les lecteurs d'ecran.
interface Props {
  nom: string;
  classe?: string;
}
const { nom, classe = 'h-8 w-8' } = Astro.props;
---
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" class={classe} aria-hidden="true">
  {
    nom === 'metal' && (
      <>
        <path d="M3.5 16.5C3.5 9 8 5 12 5s8.5 4 8.5 11.5" />
        <path d="M7.5 16.5c0-4.5 2-7.5 4.5-7.5s4.5 3 4.5 7.5" />
        <path d="M2 20h20" />
      </>
    )
  }
  {
    nom === 'electricite' && (
      <>
        <path d="M13 2.5 5 13.5h6l-1 8 8-11h-6l1-8Z" />
      </>
    )
  }
  {
    nom === 'textile' && (
      <>
        <path d="M9 5.5C9 4.1 10.3 3 12 3s3 1.1 3 2.5v13c0 1.4-1.3 2.5-3 2.5s-3-1.1-3-2.5v-13Z" />
        <path d="M9 8.5h6M9 15.5h6" />
      </>
    )
  }
  {
    nom === 'automobile' && (
      <>
        <path d="M4 15.5V13l2-4.5a1.5 1.5 0 0 1 1.4-1h9.2a1.5 1.5 0 0 1 1.4 1l2 4.5v2.5" />
        <path d="M4 15.5h16" />
        <circle cx="7.5" cy="18" r="1.6" />
        <circle cx="16.5" cy="18" r="1.6" />
        <circle cx="12" cy="9.8" r="2.2" />
      </>
    )
  }
  {
    nom === 'menuiserie' && (
      <>
        <rect x="3.5" y="14" width="17" height="5.5" rx="1" />
        <path d="M8 14V6.5a1.5 1.5 0 0 1 1.5-1.5h5A1.5 1.5 0 0 1 16 6.5V14" />
        <path d="M8 9.5h8" />
      </>
    )
  }
  {
    nom === 'graphique' && (
      <>
        <path d="M4 19C4 10 9 5 20 4" />
        <rect x="2.5" y="17.5" width="3.4" height="3.4" rx="0.6" />
        <rect x="18.3" y="2.4" width="3.4" height="3.4" rx="0.6" />
        <circle cx="11" cy="9.6" r="1.4" />
      </>
    )
  }
</svg>
