---
// Contact : coordonnees reelles, carte si fournie, reseaux et formulaire. Composant partage FR/EN.
import BaseLayout from '../../layouts/BaseLayout.astro';
import EnTetePage from '../EnTetePage.astro';
import FormContact from '../FormContact.astro';
import FormEnhancement from '../FormEnhancement.astro';
import { getOrganisation, estPresent, lienWhatsApp } from '../../lib/contenu';
import { getLang, t, type Lang } from '../../lib/i18n';

const lang: Lang = getLang(Astro.url.pathname);
const org = await getOrganisation(lang);
const adr = org.adresse ?? {};
const contacts = org.contacts ?? {};
const reseaux = org.reseaux ?? {};
const gps = org.coordinatees_gps ?? {};
const whatsapp = lienWhatsApp(contacts.whatsapp, t(lang, 'contact.whatsapp_msg'));

const ligneAdresse = [adr.rue, adr.repere, adr.quartier, adr.ville, adr.region, adr.pays]
  .filter((p) => estPresent(p))
  .join(', ');

const aUneCoordonnee = estPresent(ligneAdresse) || estPresent(contacts.telephones) || estPresent(contacts.email) || estPresent(org.horaires);
const carte = estPresent(gps.latitude) && estPresent(gps.longitude);

const titre = `${t(lang, 'contact.heading')}${t(lang, 'brand.suffix')}`;
const description = t(lang, 'contact.desc');
const fil = [{ titre: t(lang, 'contact.home'), url: '/' }, { titre: t(lang, 'contact.heading') }];
---

<BaseLayout title={titre} description={description}>
  <EnTetePage titre={t(lang, 'contact.heading')} chapeau={description} fil={fil} />

  <div class="section-titre mx-auto grid max-w-6xl gap-10 px-4 py-10 lg:grid-cols-2">
    <section aria-labelledby="coordonnees">
      <h2 id="coordonnees" class="mt-0">{t(lang, 'contact.coords')}</h2>
      {aUneCoordonnee ? (
        <dl class="mt-4 space-y-4">
          {estPresent(ligneAdresse) && (
            <div>
              <dt class="font-semibold">{t(lang, 'contact.dt_address')}</dt>
              <dd>{ligneAdresse}</dd>
            </div>
          )}
          {estPresent(org.horaires) && (
            <div>
              <dt class="font-semibold">{t(lang, 'contact.dt_hours')}</dt>
              <dd>{org.horaires}</dd>
            </div>
          )}
          {estPresent(contacts.telephones) && (
            <div>
              <dt class="font-semibold">{t(lang, 'contact.dt_phone')}</dt>
              <dd>
                <ul class="space-y-0.5">
                  {contacts.telephones?.map((tel: string) => (
                    <li><a class="no-underline hover:underline" href={`tel:${tel.replace(/[^+0-9]/g, '')}`}>{tel}</a></li>
                  ))}
                </ul>
              </dd>
            </div>
          )}
          {estPresent(contacts.email) && (
            <div>
              <dt class="font-semibold">{t(lang, 'contact.dt_email')}</dt>
              <dd><a class="no-underline hover:underline" href={`mailto:${contacts.email}`}>{contacts.email}</a></dd>
            </div>
          )}
        </dl>
      ) : (
        <p class="mt-4">{t(lang, 'contact.no_coords')}</p>
      )}

      {whatsapp && (
        <p class="mt-6">
          <a href={whatsapp} class="inline-flex items-center gap-2 rounded bg-[#128C7E] px-4 py-2.5 font-semibold text-white no-underline hover:bg-[#0f7a6e]" target="_blank" rel="noopener noreferrer">
            {t(lang, 'contact.whatsapp')}
          </a>
        </p>
      )}

      <ul class="mt-6 flex flex-wrap gap-4 text-sm">
        {estPresent(reseaux.facebook) && <li><a class="font-semibold no-underline hover:underline" href={reseaux.facebook} target="_blank" rel="noopener noreferrer">Facebook</a></li>}
        {estPresent(reseaux.tiktok) && <li><a class="font-semibold no-underline hover:underline" href={reseaux.tiktok} target="_blank" rel="noopener noreferrer">TikTok</a></li>}
      </ul>

      {carte && (
        <div class="mt-6">
          <button type="button" data-carte={gps.latitude} data-lon={gps.longitude} data-titre={t(lang, 'contact.map_title')}
            class="rounded border border-vert px-4 py-2 text-sm font-semibold text-vert no-underline hover:bg-vert-clair">
            {t(lang, 'contact.map_button')}
          </button>
          <div data-carte-zone class="mt-3 overflow-hidden rounded border border-filet"></div>
        </div>
      )}
    </section>

    <section aria-labelledby="ecrire" class="rounded border border-filet bg-white p-6">
      <h2 id="ecrire" class="mt-0 text-vert-nuit">{t(lang, 'contact.write')}</h2>
      <p class="mb-4 text-sm text-encre/80">{t(lang, 'contact.write_lede')}</p>
      <FormContact />
    </section>
  </div>

  <FormEnhancement />
  {carte && (
    <script>
      const btn = document.querySelector<HTMLButtonElement>('[data-carte]');
      const zone = document.querySelector<HTMLElement>('[data-carte-zone]');
      if (btn && zone) {
        btn.addEventListener('click', () => {
          const lat = btn.getAttribute('data-carte');
          const lon = btn.getAttribute('data-lon');
          const titre = btn.getAttribute('data-titre') || 'Map';
          const d = 0.01;
          const bbox = [Number(lon) - d, Number(lat) - d, Number(lon) + d, Number(lat) + d].join(',');
          zone.innerHTML = `<iframe title="${titre}" loading="lazy" width="100%" height="360" style="border:0" src="https://www.openstreetmap.org/export/embed.html?bbox=${bbox}&amp;layer=mapnik&marker=${lat},${lon}"></iframe>`;
          btn.remove();
        });
      }
    </script>
  )}
</BaseLayout>
