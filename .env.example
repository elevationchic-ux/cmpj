# Copier ce fichier en .env pour la production et adapter les valeurs.
# Domaine definitif du Centre (utilisé pour les URL canoniques, le sitemap et les metadonnees).
PUBLIC_SITE_URL=https://cmpj-littoral.cm

# Receptacle des demandes des formulaires (contact et pre-inscription).
# Laisser vide en attendant la configuration par la direction du Centre.
# Peut pointer vers un service de messagerie ou un webhook choisi par le prestataire.
FORMS_WEBHOOK_URL=
